{
	"name": "otel-shortener",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"shortener": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import @opentelemetry/auto-instrumentations-node/register shortener/index.js",
		"redirector": "node --import ./redirector/instrument.js redirector/index.js"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.77.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.219.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.219.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
		"@opentelemetry/resources": "^2.8.0",
		"@opentelemetry/sdk-logs": "^0.219.0",
		"@opentelemetry/sdk-node": "^0.219.0",
		"@opentelemetry/sdk-trace-node": "^2.8.0",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"cheerio": "^1.2.0",
		"express": "^5.2.1",
		"nanoid": "^5.1.14",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"redis": "^6.0.0"
	}
}
