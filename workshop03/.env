POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shortener
DATABASE_URL=postgres://postgres:postgres@db:5432/shortener
REDIS_URL=redis://redis:6379
SHORTENER_PORT=5000
REDIRECTOR_PORT=5001
REDIRECTOR_URL=http://redirector:5001

IMAGE_VERSION=workshop03
NODE_ENV=production

GF_SECURITY_ADMIN_PASSWORD=admin
JAEGER_LOG_LEVEL=debug

# grpc/http
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

OTEL_RESOURCE_ATTRIBUTES="deployment.environment.name=${NODE_ENV:-development},service.version=${IMAGE_VERSION:-1.0.0-dev},cloud_region=sin"
OTEL_NODE_RESOURCE_DETECTORS="host,env,process,container"

# grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus

OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
OTEL_EXPORTER_PROMETHEUS_PORT=9464
